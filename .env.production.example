# ─────────────────────────────────────────────────────────────
# Variables de entorno para PRODUCCIÓN — Zahavi POS
# Configurar en el panel de cada plataforma (NO commitar valores reales)
#
# Render (API):   Dashboard > zahavi-api > Environment
# Vercel (Web):   Dashboard > zahavi-web > Settings > Environment Variables
# ─────────────────────────────────────────────────────────────

# ── API (Render) ─────────────────────────────────────────────

# Cadena de conexión a Supabase.
# Origen: Supabase > Settings > Database > Connection string
# IMPORTANTE: usar modo "Session" (puerto 5432), NO "Transaction" (6543).
# La API mantiene un Pool persistente de conexiones.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Secreto para firmar JWTs. Render puede generarlo automáticamente (generateValue: true en render.yaml).
# Si lo generas manualmente: mínimo 64 caracteres aleatorios.
# DEBE coincidir con el JWT secret de Supabase si validas tokens de Supabase Auth.
JWT_SECRET=<minimo-64-caracteres-aleatorios>

# URL del frontend en Vercel. Sin barra final.
# Ejemplo: https://zahavi-web.vercel.app
CORS_ORIGIN=https://<tu-dominio>.vercel.app

# Nivel de log en producción. "info" es el valor correcto para piloto.
# Opciones: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

NODE_ENV=production
PORT=3000

# ── Web (Vercel) ──────────────────────────────────────────────

# URL pública de la API en Render. Sin barra final.
# Ejemplo: https://zahavi-api.onrender.com
VITE_API_URL=https://<tu-servicio>.onrender.com
